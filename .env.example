# Database Connection (Docker Compose Chinook DB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chinook

# Database Credentials
# Admin is used exclusively for migrations/inspections/seeding - NEVER by the LLM
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=postgres
DATABASE_URL_ADMIN=postgresql+psycopg2://postgres:postgres@localhost:5432/chinook

# Read-only User: Restricted to SELECT only, statement_timeout 5s
DB_READONLY_USER=llm_readonly
DB_READONLY_PASSWORD=readonly_secret
DATABASE_URL_READONLY=postgresql+psycopg2://llm_readonly:readonly_secret@localhost:5432/chinook

# Query Execution Safety Constraints
STATEMENT_TIMEOUT_MS=5000
ROW_CAP=100
MAX_RETRIES=2

# LLM Provider Configuration ("gemini", "openai", or "mock")
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server & UI
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
